# No model API calls are enabled in this release.
# OPENAI_API_KEY is held only in the ignored .env.local file.
# A future Groq connection uses GROQ_API_KEY as a server-side secret.
# These placeholders do not activate live AI; /api/agent is locked in code.
# See docs/ai-providers.md before a future activation.
AI_PROVIDER=
AI_MODEL=
OPENAI_MODEL=
AI_ENABLED=false
